generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  email         String    @unique
  passwordHash  String?
  image         String?
  emailVerified DateTime?

  balance Decimal @default(0.00) @db.Decimal(12, 2)

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  orders       Order[]
  transactions Transaction[]
  purchaseRateLimit PurchaseRateLimit?

  @@index([email])
  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model PurchaseRateLimit {
  id String @id @default(cuid())

  userId String @unique

  attempts Int @default(0)

  windowStartedAt DateTime
  windowEndsAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([windowEndsAt])
  @@map("purchase_rate_limits")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expiresAt  DateTime

  @@unique([identifier, token])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Order {
  id String @id @default(cuid())

  userId String

  fiveSimId String? @unique

  country  String
  operator String
  product  String

  phone String?

  amount        Decimal  @db.Decimal(12, 2)
  providerPrice Decimal? @db.Decimal(12, 2)

  currency String @default("USD")

  status OrderStatus @default(PENDING)

  smsCode String?
  smsText String?

  expiresAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transaction Transaction?

  @@index([userId])
  @@index([status])
  @@index([country])
  @@index([product])
  @@index([operator])
  @@index([createdAt])
  @@map("orders")
}

model Transaction {
  id String @id @default(cuid())

  userId  String
  orderId String? @unique

  type TransactionType

  amount Decimal @db.Decimal(12, 2)

  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  currency String @default("USD")

  description String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OrderStatus {
  PENDING
  ACTIVE
  SMS_RECEIVED
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
  FAILED
}

enum TransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  BONUS
  ADJUSTMENT
}
